<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ARCHITECTURE.md §13. Every permission here is a health-panel row, and
         every one of them can be taken away again after it is granted — which
         is why §13 models permissions as continuously observed state rather
         than as an onboarding gate. -->

    <!-- API 33+. Without it the app is INERT: the alarms still fire and
         nothing is ever shown. That is the state NotificationDelivery.
         unavailable exists to tell the domain about, so a muted phone stops
         silently consuming reminders it never delivered. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Re-arm the display-only reminders after a reboot. Handled for us by
         flutter_local_notifications' ScheduledNotificationBootReceiver, which
         is why §10's asymmetry table calls boot recovery "free" on this side. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- A midday nudge deferred by Doze into the middle of the night is worse
         than useless, so the reminders are exact.

         USE_EXACT_ALARM is available to apps whose core purpose is alarms and
         reminders. This one plausibly qualifies, but §13 is explicit: EXPECT TO
         JUSTIFY IT IN PLAY REVIEW, and write the justification before
         submitting rather than after rejection (Phase 8).

         SCHEDULE_EXACT_ALARM is the revocable sibling, declared for API 31–32
         where USE_EXACT_ALARM does not exist. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32"/>

    <!-- Merged in by flutter_local_notifications and declared here explicitly
         so it is a decision rather than an inheritance. The reminder channels
         use default vibration, so it is used; the header rule above ("every
         permission here is a health-panel row") is why an undeclared one that
         still appears in the Play listing was worth naming. Drop it with
         tools:node="remove" if the channels ever go silent-only. -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- Phase 3. android_alarm_manager_plus wakes a real Dart isolate, and the
         wake lock is what keeps the device awake long enough for it to reconcile
         and decide before the CPU sleeps again. Without it the isolate can be
         suspended mid-decision, which on this side means the warning silently
         never arrives.

         The plugin ships an EMPTY AndroidManifest, so nothing below is merged in
         for us — unlike flutter_local_notifications, whose VIBRATE arrived
         uninvited and had to be declared after the fact. Everything this plugin
         needs is declared here by hand, and was read out of the plugin's own
         sources rather than from memory. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- REQUEST_IGNORE_BATTERY_OPTIMIZATIONS is deliberately ABSENT until
         Phase 7. It is the one §13 item Phase 2 does not measure, nothing in
         lib/ calls it, and a permission with no code behind it cannot be
         justified in Play review while still appearing in the store listing.
         It comes back with the health panel that uses it. -->

    <application
        android:label="I Am Ok"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <!-- allowBackup=false, and the reason is INTEGRITY rather than privacy.
             Android's default is true, so without this the whole LocalStore is
             copied to Drive and restored onto a new device — including
             `pending_alarms`. Scheduled notifications do NOT survive a restore,
             so the restored store insists a full 7-day window is armed while
             nothing is: `desired.difference(currentlyScheduled)` is then empty,
             every reminder is skipped, and she is never nudged. LocalStore's own
             comment names that as the one direction that must never occur —
             "believing more is armed than really is would leave a reminder that
             never fires and nothing to notice it" — and Auto Backup manufactures
             it for free. In Phase 3 the same restore would suppress a warning
             that was never shown on this device.

             Nothing here is user-authored and from Phase 4 the durable truth is
             Firestore, so there is nothing worth preserving. It also keeps the
             check-in history and link graph off Drive, which has no relationship
             to the europe-west1 residency the threat model relies on.

             allowBackup covers API 30 and below. On API 31+ it does NOT cover
             device-to-device transfer, which needs the <device-transfer> block
             in @xml/data_extraction_rules — see that file. The earlier
             fullBackupContent="false" was valid but inert: it is only consulted
             when allowBackup is true, and is superseded by dataExtractionRules
             on the API levels that matter here. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Re-arms the scheduled reminders after a reboot, with no code of
             ours running. This is what makes "alarms survive a reboot" a
             property of the platform on the watched side rather than something
             this app has to get right. The watcher side's logic-bearing alarm
             is different and is Phase 3's problem. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- Delivers a scheduled notification when its instant arrives. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false"/>

        <!-- ================= The watcher's logic-bearing alarm ================
             android_alarm_manager_plus, §10's other half. These three are NOT
             merged in by the plugin — its own AndroidManifest is a single empty
             <manifest/> tag — so every one of them is declared here or the alarm
             silently never fires. Names taken from the plugin's sources.

             All three are exported="false": nothing outside this app has any
             business starting the isolate that decides whether to tell a family
             their relative missed a day. -->

        <!-- Hosts the background isolate while the callback runs. Runs as a
             JobService, hence the BIND_JOB_SERVICE permission, which the
             platform requires and which only the system holds. -->
        <service
            android:name="dev.fluttercommunity.plus.androidalarmmanager.AlarmService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false"/>

        <!-- Receives the AlarmManager broadcast and hands it to the service. -->
        <receiver
            android:name="dev.fluttercommunity.plus.androidalarmmanager.AlarmBroadcastReceiver"
            android:exported="false"/>

        <!-- Re-arms alarms after a reboot, and is deliberately enabled="false".
             The plugin enables it at runtime, and only for alarms registered
             with `rescheduleOnReboot: true` — so this is a component the app
             switches on rather than a broadcast it always answers.

             It is NOT a repair path for a force-stopped app: a stopped app
             receives no broadcasts at all, including BOOT_COMPLETED, and that
             state survives a reboot. Phase 2 measured that on this handset. -->
        <receiver
            android:name="dev.fluttercommunity.plus.androidalarmmanager.RebootBroadcastReceiver"
            android:enabled="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
