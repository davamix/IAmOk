rules_version = '2';

// I Am Ok — Firestore security rules.
//
// SPECIFICATION: the access matrix in docs/security/firestore-rules-guidelines.md,
// which implements ARCHITECTURE.md §8. **If these rules and that table disagree,
// one of them is a bug** — fix one of them, do not leave both standing.
//
// These rules are the only real authorisation boundary in this app. The client
// is untrusted by definition: it runs on hardware the user controls and its code
// can be read out of the APK. A check that lives only in Dart is a UX
// affordance, not a control.
//
// They are also PUBLIC, and that is fine — a ruleset that is only safe while
// unread is not safe (docs/security/secrets-policy.md).
//
// Deployed with:
//   firebase deploy --only firestore:rules --project i-am-ok-c74ca
//
// Tested with the emulator suite only, never against the live project:
//   pwsh -File tools/rules-test.ps1
//
// ONE THING TO HOLD ON TO WHILE EDITING THIS FILE. A denied write is not a
// neutral outcome here. ADR-0004 maps `permission-denied` to **refused**, which
// drives the watcher's access-lost notification and its 0/1/3/7/14-day cadence —
// so a rule that is too strict does not merely inconvenience a user, it tells a
// family that the app has lost sight of their relative. A bad rules deploy is
// listed in ARCHITECTURE.md §17 as the one config error that becomes a
// fleet-wide false alarm. Where a bound cannot be expressed exactly, prefer the
// slack that never rejects a legitimate write (see `awayWithinCap` below).

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── identity ──────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ─── the accepted-link get() ───────────────────────────────────────────
    //
    // Factored into one function on purpose: it is reached from three places
    // (away read, away write, check-in read) and duplicating it is how the
    // three drift apart.
    //
    // The link id is deterministic — `{watchedUid}_{watcherUid}` (§7) — so
    // "does an accepted link exist between the watched person and the caller"
    // is answerable by document id, with no query.
    //
    // The read this costs is ACCEPTED COST, not something to optimise away.
    // Removing it would leave the watcher unable to pull the truth from
    // Firestore at alarm time, which is the whole of what makes the warning
    // trustworthy; §3 explicitly refuses to let FCM carry correctness.

    function linkPath(watchedUid) {
      return /databases/$(database)/documents/links/$(watchedUid + '_' + request.auth.uid);
    }

    function hasAcceptedLink(watchedUid) {
      return signedIn()
          && exists(linkPath(watchedUid))
          && get(linkPath(watchedUid)).data.status == 'accepted';
    }

    // ─── dates ─────────────────────────────────────────────────────────────
    //
    // Days in this data model are LABELS in someone's local timezone, never
    // instants (§11). The rules engine has no timezone conversion and cannot
    // know the watched person's zone, so every comparison below between a day
    // label and `request.time` is inexact by up to a day. That is understood
    // and bounded, not overlooked — see `awayWithinCap` and `awayNotRetroactive`.

    function isDayKey(value) {
      return value is string
          && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // A `YYYY-MM-DD` label read as midnight UTC on that date.
    //
    // Callers must have established isDayKey() first: int() on a non-numeric
    // string is an error, and an error denies the write rather than returning
    // false, which would be a confusing denial with no cause.
    function dayStart(value) {
      return timestamp.date(
        int(value.split('-')[0]),
        int(value.split('-')[1]),
        int(value.split('-')[2]));
    }

    // Midnight UTC today, so day labels are compared against a day rather than
    // against an instant part-way through one.
    function todayStartUtc() {
      return timestamp.date(request.time.year(), request.time.month(), request.time.day());
    }

    // ─── users/{uid} ───────────────────────────────────────────────────────
    //
    // Read and write: SELF ONLY, and that is load-bearing rather than merely
    // tidy. It is why §7 denormalises `watchedName`, `watcherName` and
    // `watchedTimezone` onto the link: no user ever reads another user's
    // document, in either direction. Do not relax this to "or a linked party" —
    // that would let every watched person read the profile of everyone watching
    // them, and buys nothing the link does not already carry.

    function userFields() {
      return ['displayName', 'timezone', 'createdAt', 'lastSeenAt'];
    }

    function validUserShape(data) {
      return data.keys().hasOnly(userFields())
          && data.keys().hasAll(userFields())
          && data.displayName is string
          && data.displayName.size() >= 1
          && data.displayName.size() <= 100
          && data.timezone is string
          && data.timezone.size() >= 1
          && data.timezone.size() <= 100
          && data.createdAt is timestamp
          && data.lastSeenAt == request.time;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
                    && validUserShape(request.resource.data)
                    && request.resource.data.createdAt == request.time;
      allow update: if isSelf(uid)
                    && validUserShape(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSelf(uid);

      // ─── users/{uid}/tokens/{token} ──────────────────────────────────────
      //
      // A subcollection rather than an array field (§7) so the Function can
      // prune by age and by UNREGISTERED without rewriting the user document.
      // The document id IS the FCM token.

      match /tokens/{token} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
                              && request.resource.data.keys().hasOnly(['platform', 'updatedAt'])
                              && request.resource.data.keys().hasAll(['platform', 'updatedAt'])
                              && request.resource.data.platform == 'android'
                              && request.resource.data.updatedAt == request.time;
        allow delete: if isSelf(uid);
      }

      // ─── users/{uid}/shared/away ─────────────────────────────────────────
      //
      // ONE document, one truth (§12). Away is a property of the watched
      // PERSON, not of a pair, because during away there are no taps at all —
      // a per-link copy would be a fan-out write that can partially fail and
      // leave one watcher warning through a holiday.
      //
      // A DIRECT CLIENT WRITE rather than a callable, on purpose: a watcher can
      // set away on a plane and have it queue offline like any other Firestore
      // write. Validation therefore has to live here.
      //
      // Anyone in the group may set, extend or cancel it, with no approval
      // (§12) — a watcher setting away is asserting "I know she's fine, and I'm
      // accountable for that", which is exactly what happens when someone is in
      // hospital and least able to answer a prompt.

      match /shared/away {

        function awayFields() {
          return ['from', 'through', 'setBy', 'setByName', 'setAt', 'updatedAt'];
        }

        function validAwayShape(data) {
          return data.keys().hasOnly(awayFields())
              && data.keys().hasAll(awayFields())
              && isDayKey(data.from)
              && isDayKey(data.through)
              && data.setBy is string
              && data.setByName is string
              // TRIMMED, because `size() >= 1` alone admits "   " — which
              // renders as the unattributed string on every surface and so
              // silently disables ADR-0003 rule 2's whole point: no client may
              // turn off section 17's control by writing a name that names
              // nobody. Omitting the field is already denied; three spaces
              // achieved the same thing.
              && data.setByName.trim().size() >= 1
              && data.setByName.size() <= 100
              && data.setAt == request.time
              && data.updatedAt == request.time;
        }

        // ADR-0003. `setBy` is the identity and is enforced; `setByName` is a
        // display label and is NOT authenticated — §8 grants users write-to-self
        // over their own displayName, so anyone can rename themselves before
        // writing, and a rules get() comparing the two would cost a read and
        // prove nothing. Do not add that check; ADR-0003 records why.
        //
        // Both are deliberately MUTABLE on update, unlike `from`: §12 is
        // last-write-wins, so extending someone else's away period must
        // re-attribute it to whoever wrote last.
        function validAttribution(data) {
          return data.setBy == request.auth.uid;
        }

        function orderedPeriod(data) {
          return data.through >= data.from;   // both are YYYY-MM-DD, so lexicographic == chronological
        }

        // THE CAP IS DELIBERATELY SLACK, and this is the clause the guidelines
        // spend a section on. `through` is a date in the WATCHED PERSON'S zone;
        // `request.time` is a UTC instant and the rules engine cannot convert
        // between them. Adding a duration to an instant is not calendar
        // arithmetic either — 720 hours across a DST transition lands on day+29
        // or day+31. So this admits roughly 30-33 days depending on the zone,
        // the time of day, and DST.
        //
        // That slack is chosen, not tolerated: a rejected away write queues
        // offline and resurfaces later with no visible cause, which is far worse
        // than admitting a period a day or two over a guardrail.
        //
        // THE EXACT 31-DAY CAP IS `AwayRules` in the domain layer, which is
        // given a `today` already resolved in the watched person's zone — the
        // only place the question is well-posed. These rules stop the ABSURD
        // case (a ten-year away that silences a family forever), which is the
        // whole of what they are for. `AwayPeriod.clampedToSanityBound()` is the
        // third defence, at read time, at 60 days.
        function awayWithinCap(data) {
          return dayStart(data.through) <= request.time + duration.value(32, 'd');
        }

        // NO RETROACTIVE AWAY (§12) — `from` is today at the earliest, and this
        // is a CREATE-ONLY rule. Cancellation truncates rather than deletes
        // (ADR-0001), which rewrites an in-progress period whose `from` is
        // already in the past; a blanket `from >= today` would reject exactly
        // the write that stops a cancellation retroactively un-covering days
        // already spent away. Immutability on update is what replaces it.
        //
        // The one day of slack is the same UTC-versus-local-date problem as the
        // cap, in the other direction, and it is not optional: for a watched
        // person in Los Angeles the local date is the PREVIOUS UTC date for much
        // of each day, so a strict comparison would reject a perfectly ordinary
        // "away from today" write. Biased, as everywhere in this file, towards
        // never rejecting a legitimate write.
        function awayNotRetroactive(data) {
          return dayStart(data.from) >= todayStartUtc() - duration.value(1, 'd');
        }

        function mayWriteAwayFor(uid) {
          return isSelf(uid) || hasAcceptedLink(uid);
        }

        allow read: if mayWriteAwayFor(uid);

        allow create: if mayWriteAwayFor(uid)
                      && validAwayShape(request.resource.data)
                      && validAttribution(request.resource.data)
                      && orderedPeriod(request.resource.data)
                      && awayWithinCap(request.resource.data)
                      && awayNotRetroactive(request.resource.data);

        // `from` IS FROZEN FOR THE LIFE OF A PERIOD, NOT OF A PERSON.
        //
        // Nothing deletes this document when a period runs its course —
        // deliberately, because the days already spent away must stay covered
        // (ADR-0001). So the record outlives the holiday, and a flat
        // `from == resource.data.from` meant away could be set ONCE per person
        // and then never again: every later attempt refused, on both sides,
        // for ever. Section 12 says "to go longer, set it again", and the
        // guidelines say a determined person "can set it twice"; neither was
        // reachable.
        //
        // ADR-0001 decision 6's reason is that truncating an IN-PROGRESS period
        // rewrites a document whose `from` is already past. An ended period is
        // not in progress, so the reason does not reach it.
        //
        // BIASED STRICT, against this file's usual grain, and deliberately.
        // `through` is a local date and `todayStartUtc()` a UTC one, so this is
        // inexact by up to a day either way. Too permissive would let a new
        // `from` land while a period still has a day to run, un-covering days
        // already spent away — the false claim to a family that ADR-0001 exists
        // to prevent. Too strict costs a legitimate re-set a few hours' delay
        // at a zone boundary, which is recoverable and says nothing false. The
        // exact check is the client's, where the day is resolved in the watched
        // person's own zone.
        function awayPeriodEnded() {
          return dayStart(resource.data.through) < todayStartUtc();
        }

        allow update: if mayWriteAwayFor(uid)
                      && validAwayShape(request.resource.data)
                      && validAttribution(request.resource.data)
                      && orderedPeriod(request.resource.data)
                      && awayWithinCap(request.resource.data)
                      && (request.resource.data.from == resource.data.from
                          || (awayPeriodEnded()
                              && awayNotRetroactive(request.resource.data)));

        // Cancelling on the day the period starts deletes rather than truncates
        // — nothing has elapsed, and truncating would write
        // `through = from - 1` and violate `through >= from` (§12).
        allow delete: if mayWriteAwayFor(uid);
      }
    }

    // ─── links/{id} ────────────────────────────────────────────────────────
    //
    // Function-written, with one exception. Creation goes through the
    // `redeemInvite` callable so single-use and expiry are enforced server-side
    // and the client never learns another user's uid from an invite.
    //
    // Either party may set `status: "revoked"` AND NOTHING ELSE — because
    // either party must be able to walk away without a round trip. Revocation
    // is final: ADR-0004 decision 7 has the watcher withdraw any standing
    // warning rather than correct it, since every later read is refused and
    // nothing could ever clear it.

    match /links/{linkId} {
      function isParty() {
        return signedIn()
            && (resource.data.watchedUid == request.auth.uid
             || resource.data.watcherUid == request.auth.uid);
      }

      allow read: if isParty();

      allow update: if isParty()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status == 'revoked';

      // Functions bypass rules entirely, so denying these here costs nothing.
      allow create, delete: if false;
    }

    // ─── checkins/{uid}/days/{date} ────────────────────────────────────────
    //
    // THE DOCUMENT ID IS THE DAY, in the watched person's timezone (§7). That
    // gives once-per-day semantics for free: a second tap the same day is an
    // UPDATE, which does not fire `onDocumentCreated`, so there is no duplicate
    // push and no dedupe logic anywhere.
    //
    // Read: self, or an accepted link. That grant is what makes the watcher's
    // pull-based reconcile possible at all (§3).
    // Write: self only — per the access matrix, delete included.
    //
    // The day label is validated for SHAPE and is deliberately NOT bounded
    // against `request.time`. An offline tap syncs days later and is legitimate
    // (§11), so only the future side could be bounded, and the watched person's
    // zone can already put their local today one UTC day ahead. The real
    // exposure — a device with a badly skewed clock filing a check-in years
    // ahead, which would satisfy `lastConfirmedDay >= D` and silence the
    // watcher forever — is closed where the question is well-posed: the
    // watcher's reader asks for a BOUNDED WINDOW of specific days, so a
    // far-future document is never read. Same division of labour as the away
    // cap: the rules stop the absurd shape, the client bounds the exact thing.

    match /checkins/{uid}/days/{date} {
      function validCheckIn(data) {
        return isDayKey(date)
            && data.keys().hasOnly(['deviceTappedAt', 'receivedAt', 'timezone'])
            && data.keys().hasAll(['deviceTappedAt', 'receivedAt', 'timezone'])
            && data.deviceTappedAt is timestamp
            && data.receivedAt == request.time
            && data.timezone is string
            && data.timezone.size() >= 1
            && data.timezone.size() <= 100;
      }

      allow read: if isSelf(uid) || hasAcceptedLink(uid);

      // `deviceTappedAt` is the CLIENT clock and is displayed, never authorised
      // on (§11): a tap at 23:50 that syncs at 08:00 must still be shown as
      // 23:50. `receivedAt` is `request.time` and is the only trusted one.
      allow create, update: if isSelf(uid) && validCheckIn(request.resource.data);
      allow delete: if isSelf(uid);
    }

    // ─── invites/{code} ────────────────────────────────────────────────────
    //
    // UNREADABLE BY EVERY CLIENT — not "readable only by the creator". A
    // readable invite collection is an enumerable list of live codes. Redemption
    // happens exclusively inside the `redeemInvite` callable, which also means
    // the client never learns another user's uid from an invite document.

    match /invites/{code} {
      allow read, write: if false;
    }

    // ─── everything else ───────────────────────────────────────────────────
    //
    // Anything not matched above is already denied — this states it rather than
    // relying on the absence of a match, so a future `match` added in the wrong
    // place is a visible change rather than a silent widening.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
